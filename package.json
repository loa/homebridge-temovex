{
  "name": "homebridge-temovex",
  "displayName": "Temovex",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Homebridge thermostat and temperature sensors for a REC Temovex unit, via modbus-proxy.",
  "author": "loa",
  "license": "Apache-2.0",
  "homepage": "https://github.com/loa/homebridge-temovex#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/loa/homebridge-temovex.git"
  },
  "bugs": {
    "url": "https://github.com/loa/homebridge-temovex/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "temovex"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "pretest": "npm run build",
    "test": "node --test dist/proxy.test.js",
    "watch": "npm run build && npm link && nodemon"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
